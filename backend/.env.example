# Copy to .env for local development. NEVER commit .env. Real values live in the host dashboard (Render).
PORT=3001

# Database. Leave DATABASE_URL empty locally to use the SQLite file below.
DATABASE_PATH=data/service-hub.sqlite
# Hosted Postgres (Neon), e.g. postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
# "true" only for the very first deploy on an empty database (creates tables), then set to "false".
DB_SYNCHRONIZE=

# Browser origins allowed to call the API (comma-separated, no trailing slash).
CORS_ORIGINS=http://localhost:5173

# Triage AI. Leave BOTH empty to use the deterministic fallback.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
# How long a failed triage call keeps /health/ready "degraded" (ms). Default 10 minutes.
AI_STATUS_TTL_MS=600000

FIREBASE_PROJECT_ID=your-firebase-project-id
# Local ADC or a service-account JSON object (set in the host dashboard only for production).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Server-owned role mapping keyed by Firebase UID only. Unlisted accounts are Employees.
# Example (placeholders, replace with your real UIDs on the host only):
FIREBASE_ROLE_ASSIGNMENTS={"ADMIN_FIREBASE_UID":{"role":"Admin"},"IT_STAFF_FIREBASE_UID":{"role":"Staff","departmentId":"DEPT-IT"},"HR_STAFF_FIREBASE_UID":{"role":"Staff","departmentId":"DEPT-HR"},"FINANCE_STAFF_FIREBASE_UID":{"role":"Staff","departmentId":"DEPT-FINANCE"}}

# For local development, provide Google Application Default Credentials using
# GOOGLE_APPLICATION_CREDENTIALS outside this file if Admin SDK credentials are needed.
