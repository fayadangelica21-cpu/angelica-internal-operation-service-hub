# Copy to frontend/.env for local development. Vite exposes only VITE_* variables to the browser,
# so never put secrets here.
# URL of the backend API. Empty in dev if you use the Vite proxy; on Render set it to the API URL.
VITE_API_URL=http://localhost:3001

# Firebase WEB config is public by design (access is enforced by Firebase Authorized domains and
# server-side token verification). Optional: the app has built-in defaults for the project.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
